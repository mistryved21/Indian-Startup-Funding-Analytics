{
  "name": "Indian Startup Funding",
  "dataColors": ["#1F4E79", "#E07B39", "#4F81A8", "#8A8F98", "#7FA6CC", "#B85A1B", "#2E7D6B", "#5C6B7A", "#BFD3E6", "#F2B28A"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F4E79",
  "good": "#2E7D6B",
  "neutral": "#C9A227",
  "bad": "#C0392B",
  "minimum": "#E8F0F8",
  "center": "#8DB1D3",
  "maximum": "#1F4E79",
  "null": "#D9DEE4",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52606D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F2933" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E6EC" } }, "radius": 6 }],
        "padding": [{ "top": 6, "bottom": 6, "left": 8, "right": 8 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }]
      }
    }
  }
}
